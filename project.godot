; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Undead Empire Prototype"
config/description="Villain settlement-builder roguelite prototype (Phase 1: Undead Empire class, Frozen Wastes climate)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/icon_settlement.png"

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
BuildingCatalog="*res://scripts/autoload/BuildingCatalog.gd"
RaceCatalog="*res://scripts/autoload/RaceCatalog.gd"
MCPRuntimeBridge="*res://addons/godot_mcp/services/mcp_runtime_bridge.gd"
MCPInputBridge="*res://addons/godot_mcp/services/mcp_input_bridge.gd"
MCPScreenshotBridge="*res://addons/godot_mcp/services/mcp_screenshot_bridge.gd"

[display]

window/size/viewport_width=1400
window/size/viewport_height=760

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[rendering]

; Linear with mipmaps. The enum is "Nearest,Linear,Linear Mipmap,Nearest
; Mipmap", so 2 is Linear Mipmap -- Nearest Mipmap is 3, which is not the
; usual ordering and is worth reading twice. Chosen because this art is not
; pixel art (Human_Outcast.png alone has 63,895 unique RGBA colours), and
; mipmapped because 128px sources draw at 40-70px and that undersampling is
; what shimmers while a unit walks.
;
; NOTE the key is section-relative: inside [rendering] this must be
; "textures/..." and NOT "rendering/textures/...". Written the long way it
; silently defines rendering/rendering/textures/... which nothing reads, and
; the filter stays at its Linear default with no mipmaps.
;
; The Godot editor strips these comments whenever it re-saves this file. If
; they are gone again, restore them -- the setting survives, the reasoning
; does not.
textures/canvas_textures/default_texture_filter=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
